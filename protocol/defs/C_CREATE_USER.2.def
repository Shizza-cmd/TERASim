# class: 0 warrior, 1 lancer, 2 slayer, 3 berserker, 4 sorcerer, 5 archer,
#        6 priest, 7 mystic, 8 reaper, 9 gunner, 10 brawler, 11 ninja, 12 valkyrie
string name
bytes details
bytes shape
int32 gender
